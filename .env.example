# ---- Database ----
# Leave empty for local development: an embedded PostgreSQL (PGlite) is stored in ./.data/pglite
# Production: any PostgreSQL 14+ connection string (Neon, Supabase, RDS, Vercel Postgres...)
DATABASE_URL=

# ---- Auth ----
# Random 32+ byte secret used for CSRF/origin checks and signing. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the app (used for origin checks + push notifications)
APP_URL=http://localhost:3000

# ---- AI (Claude) ----
# Required for food photo recognition, label OCR, recipe parsing and the AI coach.
# Paid API: https://platform.claude.com  — all non-AI features work without it.
ANTHROPIC_API_KEY=
# Optional override (default claude-opus-5-5)
AI_MODEL=claude-opus-5-5

# ---- Image storage ----
# "local" (default, stores in ./uploads — NOT suitable for serverless) or "s3" (any S3-compatible: AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Push notifications (optional) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Food data ----
# Optional USDA FoodData Central API key (only for online lookups; bulk import uses public CSV downloads)
USDA_API_KEY=

# ---- Scheduled jobs ----
# Secret for /api/cron/reminders (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=
