# ---- Database ----
# Leave empty for local development: an embedded PostgreSQL (PGlite) is stored in ./.data/pglite
# Production: any PostgreSQL 14+ connection string (Neon, Supabase, RDS, Vercel Postgres...)
DATABASE_URL=

# ---- Auth ----
# Random 32+ byte secret used for CSRF/origin checks and signing. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the app (used for origin checks + push notifications)
APP_URL=http://localhost:3000

# ---- Sign in with Google (optional) ----
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID → "Web application".
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback (and https://<your-domain>/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI (Google Gemini) ----
# Required for food photo recognition, label OCR, recipe parsing and the AI coach.
# Get a key at https://aistudio.google.com/apikey — all non-AI features work without it.
GEMINI_API_KEY=
# Optional model override — comma-separated fallback chain
# (default gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite). gemini-1.5/2.x are retired.
GEMINI_MODEL=

# ---- Image storage ----
# "local" (default, stores in ./uploads — NOT suitable for serverless) or "s3" (any S3-compatible: AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Push notifications (optional) ----
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Food data ----
# Optional USDA FoodData Central API key (only for online lookups; bulk import uses public CSV downloads)
USDA_API_KEY=

# ---- Scheduled jobs ----
# Secret for /api/cron/reminders (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=
